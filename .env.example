# Fitr — environment reference. NAMES ONLY: put real values in .env.local (git-ignored) and in the Convex dashboard / `npx convex env set`.

# --- Local frontend (written by `npx convex dev` into .env.local) ---
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# --- Convex deployment environment variables (set with `npx convex env set NAME value`) ---
# Convex Auth (generated by `npx @convex-dev/auth`):
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=
# Firecrawl — product pages, size charts, retailer contacts, alternative retailers:
FIRECRAWL_API_KEY=
# OpenAI — "See it on me" image generation and the received-item photo comparison:
OPENAI_API_KEY=
# AgentMail — sending the approved complaint and receiving replies:
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=

# --- Optional overrides ---
# OPENAI_VISION_MODEL=
# OPENAI_IMAGE_MODEL=
# FIRECRAWL_BASE_URL=
# AGENTMAIL_BASE_URL=
# AGENTMAIL_TEST_RECIPIENT=   # redirects every outgoing email to one address (safe testing)
